# Absolute path inside the container; /data is the mounted volume
DATABASE_PATH=/data/composer.sqlite
# Public URL of the app (used for cookies and share links)
ORIGIN=https://cv.example.com
PORT=3000
# Generated with: openssl rand -base64 32
SESSION_SECRET=
# First admin account, created on first start if no admin exists (step 2)
ADMIN_EMAIL=
