# development | staging | production — staging and production require https ORIGIN
APP_ENV=staging
# Public URL of the app (cookies, CSRF check and printed links depend on it)
ORIGIN=https://cv.example.com
PORT=3000
# Absolute path inside the container; /data is the mounted volume
DATABASE_PATH=/data/composer.sqlite
# First admin: a one-time sign-up link for this address is printed to the log on start
ADMIN_EMAIL=
# Only if a reverse proxy sits in front of the container
# ADDRESS_HEADER=X-Forwarded-For
